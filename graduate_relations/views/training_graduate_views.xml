<odoo>
    <record id="view_training_graduate_list" model="ir.ui.view">
        <field name="name">training.graduate.list</field>
        <field name="model">training.graduate</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="trainee_count"/>
            </list>
        </field>
    </record>

    <record id="view_training_graduate_form" model="ir.ui.view">
        <field name="name">training.graduate.form</field>
        <field name="model">training.graduate</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <div class="oe_button_box" name="button_box">

                        <button name="action_view_cv"
                                type="object"
                                string="View CV"
                                class="oe_stat_button"
                                icon="fa-file-text">
                        </button>

                        <button name="action_view_graduate_courses"
                            type="object"
                            string="Courses"
                            class="oe_stat_button"
                            icon="fa-graduation-cap">

                        </button>


                            <button name="action_event" type="object"
                                    string="Events"
                                    class="oe_stat_button" icon="fa-flag">
                        <!--   <field name="event_count" widget="statinfo"/>-->
                            </button>

                    </div>
                    <group>
                        <field name="partner_id"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="mobile"/>
                        <field name="national_id"/>
                        <field name="function"/>
                        <field name="specialization"/>
                        <field name="program"/>
                        <field name="division"/>
                        <field name="trainee_count" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Courses">
                            <field name="course_ids" widget="many2many_tags" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_training_graduate_kanban" model="ir.ui.view">
        <field name="name">training.graduate.kanban</field>
        <field name="model">training.graduate</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="partner_id"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="trainee_count" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record bg-light p-3 rounded shadow-sm">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <strong class="fs-5 text-primary">
                                    <t t-esc="record.partner_id.value"/>
                                </strong>
                                <span class="badge bg-info text-dark">
                                    <t t-esc="record.trainee_count.value"/> 🧑‍🎓
                                </span>
                            </div>

                            <div class="text-muted mb-2">
                                <i class="fa fa-envelope text-secondary"></i>
                                <t t-esc="record.email.value or '-'"/>
                            </div>

                            <div class="text-muted mb-3">
                                <i class="fa fa-phone text-secondary"></i>
                                <t t-esc="record.phone.value or '-'"/>
                            </div>

                            <div class="d-flex justify-content-around">
                                <a type="object" name="action_view_cv"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="fa fa-file-text"></i> CV
                                </a>

                                <a type="object" name="action_view_graduate_courses"
                                   class="btn btn-sm btn-outline-success">
                                    <i class="fa fa-graduation-cap"></i> Courses
                                </a>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="training_graduate_view_search" model="ir.ui.view">
        <field name="name">training.graduate.view.search</field>
        <field name="model">training.graduate</field>
        <field name="arch" type="xml">
            <search string="Training Graduates">

                <!-- SEARCH -->
                <field name="partner_id"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="mobile"/>

                <!-- GROUP BY -->
                <group expand="0" string="Group By">
                    <filter string="Graduate" name="group_partner" context="{'group_by':'partner_id'}"/>
                </group>

            </search>
        </field>
    </record>


    <record id="action_training_graduate" model="ir.actions.act_window">
        <field name="name">Graduates</field>
        <field name="res_model">training.graduate</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="menu_training_graduate"
              name="Graduates"
              parent="menu_graduates_root"
              action="action_training_graduate"
              sequence="10"/>
</odoo>
