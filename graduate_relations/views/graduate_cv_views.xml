<odoo>
    <record id="view_graduate_cv_form" model="ir.ui.view">
        <field name="name">graduate.cv.form</field>
        <field name="model">graduate.cv</field>
        <field name="arch" type="xml">
            <form string="Graduate CV" create="false" edit="true">
                <sheet>
                    <h1>
                        <field name="name" readonly="1" class="oe_inline"/>
                    </h1>

                    <group>
                        <field name="education"/>
                        <field name="skill_ids" widget="many2many_tags" />
                        <field name="language_ids" widget="many2many_tags" />
<!--                        <field name="user_language_ids" widget="many2many_tags"/>-->

                    </group>

                    <notebook>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>

                        <page string="Experiences">
                            <field name="experience_ids"/>
                        </page>


                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
