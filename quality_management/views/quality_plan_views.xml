<odoo>
    <record id="view_quality_plan_list" model="ir.ui.view">
        <field name="name">quality.plan.list</field>
        <field name="model">quality.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <!-- <field name="project_id"/> -->
                <field name="progress"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_quality_plan_form" model="ir.ui.view">
        <field name="name">quality.plan.form</field>
        <field name="model">quality.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                        <!-- <button name="action_start" string="Start" type="object" class="btn-primary"
                                invisible="state != 'draft' "/>
                        <button name="action_complete" string="Mark as Done" type="object" class="btn-success"
                                invisible="state != 'in_progress' "/> -->
                    
                        <field name="state" widget="statusbar"
                                statusbar_visible="draft, in_progress, done" />  
                    </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                            <button name="action_view_procedures"
                                    type="object" string="Plan Procedures"
                                    class="oe_stat_button axis-btn" icon="fa-list">
                                
                                <!-- <field name="decision_count" widget="statinfo" /> -->
                            </button>
                        </div>
                    <group>
                        <field name="name"/>
                        <field name="plan_manager_id"/>
                        <field name="issue_description"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="progress"/>
                        
                    </group>

                    <notebook>
                        <page string="Procedures">
                            <field name="procedure_ids" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="name"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>


                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="quality_plan_view_search" model="ir.ui.view">
        <field name="name">quality.plan.search</field>
        <field name="model">quality.plan</field>
        <field name="arch" type="xml">
            <search string="Quality Plans">

                <!-- SEARCH -->
                <field name="name"/>
                <field name="plan_manager_id"/>
                <field name="start_date"/>

                <!-- FILTER -->
                <filter string="Draft"
                        name="draft"
                        domain="[('state','=','draft')]"/>

                <filter string="In Progress"
                        name="in_progress"
                        domain="[('state','=','in_progress')]"/>

                <filter string="Done"
                        name="done"
                        domain="[('state','=','done')]"/>

                <!-- GROUP BY -->
                <group expand="0" string="Group By">
                    <filter string="State"
                            name="group_state"
                            context="{'group_by':'state'}"/>

                    <filter string="Responsible"
                            name="group_plan_manager"
                            context="{'group_by':'plan_manager_id'}"/>
                </group>

            </search>
        </field>
    </record>


    <record id="action_quality_plans" model="ir.actions.act_window">
        <field name="name">Quality Plans</field>
        <field name="res_model">quality.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
