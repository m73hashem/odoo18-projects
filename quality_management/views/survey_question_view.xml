<odoo>
    <data>
        <record id="metric_survey_question_form_inherit" model="ir.ui.view">
            <field name="name">metric.survey.question.form.inheri</field>
            <field name="model">survey.question</field>
            <field name="inherit_id" ref="survey.survey_question_form"/>
            <field name="arch" type="xml">

                <xpath expr="//page[@name='mapping']" position="attributes">
                        <attribute name="invisible">metric_id != False</attribute>
                </xpath>

                <xpath expr="//notebook" position="inside">
                    <page string="Mapping" name="mapping2" invisible="metric_id == False">
                        <group>
                            <field name="metric_criteria_id"/>
                            <field name="participant_field" widget="radio"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
