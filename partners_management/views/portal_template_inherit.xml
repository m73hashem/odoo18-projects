<odoo>
    <template id="portal_my_home_inherit_custom" inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="partner"
               t-value="request.env['custom.partner'].sudo().search([('responsible_user_id', '=', request.env.user.id)], limit=1)"/>
            <t t-if="request.env.user.has_group('base.group_portal') and partner">
                <div class="o_portal_index_card col-md-6 order-2">
                    <a href="/my/partner" title="Partner &amp; Security"
                       class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                        <div class="o_portal_icon d-block align-self-start">
                            <img src="/partners_management/static/img/tasks.svg" loading="lazy"/>
                        </div>

                        <div class="">
                            <div class="mt-0 mb-1 fs-5 fw-normal lh-1 ">
                                <span>partner Information</span>
                            </div>

                            <div class="opacity-75">
                                Configure your Information
                            </div>
                        </div>
                    </a>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
