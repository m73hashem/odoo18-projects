<odoo>
  <template id="portal_my_partner_page" name="My Partner Page">
    <t t-call="portal.portal_layout">
      <div class="container">
        <h3>My Partner Information</h3>

        <!-- show/update partner_description -->
        <t t-if="partner.allow_portal_edit and partner.responsible_user_id.id == request.env.user.id">
          <!-- Editable -->
          <form action="/my/partner/update" method="post">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <div class="form-group">
              <label>Description:</label>
              <input type="text" name="partner_description" class="form-control"
                     t-att-value="partner.partner_description"
                     placeholder="Partner Description"/>
            </div>
            <button type="submit" class="btn btn-primary">Update</button>
          </form>
        </t>
        <t t-else="">
          <!-- Readonly -->
          <div class="form-group">
            <label>Description:</label>
            <input type="text" class="form-control" readonly="readonly"
                   t-att-value="partner.partner_description"/>
          </div>
        </t>

        <hr/>
        <h4>Attachments</h4>
        <t t-foreach="partner.custom_attachment_ids" t-as="att">
          <div>
            <a t-att-href="'/web/content/%s?download=true' % att.id" target="_blank">
              <t t-esc="att.name"/>
            </a>
          </div>
        </t>

        <!-- upload attachments -->
        <t t-if="partner.allow_portal_edit and partner.responsible_user_id.id == request.env.user.id">
          <form action="/my/partner/upload_attachments" method="post" enctype="multipart/form-data" class="mt-3">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="model" value="custom.partner"/>
            <input type="hidden" name="id" t-att-value="partner.id"/>
            <input type="file" name="ufile" multiple="multiple" class="form-control"/>
            <button type="submit" class="btn btn-secondary">Upload</button>
          </form>
        </t>
      </div>
    </t>
  </template>
</odoo>
