<odoo>
    <!-- Form View -->
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">partner.form</field>
        <field name="model">custom.partner</field>
        <field name="groups_id" eval="[(4, ref('partners_management.group_partner_manager'))]"/>
        <field name="arch" type="xml">
            <form string="Partner">

                <sheet>
                        <!-- Smart Buttons -->
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_plans" type="object" class="oe_stat_button" icon="fa-tasks">
                                <field name="plan_count" widget="statinfo"/>
                            </button>
                            <button name="action_view_evaluations" type="object" class="oe_stat_button" icon="fa-star">
                                <field name="evaluation_count" widget="statinfo"/>
                            </button>
                            <button name="action_view_activities" type="object" class="oe_stat_button" icon="fa-calendar">
                                <field name="activity_count" widget="statinfo"/>
                            </button>
                        </div>

                        <widget name="web_ribbon" title="Approved" bg_color="text-bg-success"
                            invisible="not partner_approved"/>

          <!-- ================= HEADER CARD ================= -->
                    <div class="o_form_header bg-white shadow-sm"
                         style="display:flex;align-items:center;justify-content:space-between;
                                border-radius:12px;padding:20px 25px;margin-bottom:25px;">

                        <div style="display:flex;align-items:center;gap:20px;">
                            <field name="company_logo" widget="image"
                                   class="shadow-sm"
                                   style="width:100px;height:100px;object-fit:contain;
                                          border:1px solid #e0e0e0;border-radius:12px;"/>

                            <div>
                                <h1 style="margin:0;font-size:26px;font-weight:600;color:#222;">
                                    <field name="name"/>
                                </h1>

                                <div style="margin-top:8px;width:60px;height:3px;background-color:#008080;border-radius:2px;"></div>
                            </div>
                        </div>

                        <div style="margin-right: 20px;">
                            <field name="partner_approved"
                                   widget="boolean_toggle_labeled"
                                   options="{'false_label': 'Not Approved', 'true_label': 'Approved'}"/>
                        </div>
                    </div>

                    <!-- ================= SECTION: PARTNER INFORMATION ================= -->
                    <div style="margin-top:10px;">
                        <div style="border-left:4px solid #008080;padding-left:10px;margin-bottom:10px;">
                            <span style="font-size:15px;font-weight:600;color:#008080;letter-spacing:0.5px;">
                                PARTNER INFORMATION
                            </span>
                        </div>

                        <group >
                            <group>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="partnership_duration"/>
                                <field name="website_url"/>
                                <field name="country"/>
                                <field name="partner_description"/>
                            </group>

                            <group>

                                <field name="plan_progress"
                                       string="Progress "
                                       widget="progressbar"
                                       options="{'max_value': 100}"
                                       readonly="1"/>
                                <field name="partner_type"/>
                                <field name="partnership_type_id"/>
                                <field name="priority" widget="priority"/>
                                <field name="signature_date"/>
                                <field name="responsible_user_id"/>
                                <field name="allow_portal_edit"
                                       groups="partners_management.group_partner_manager"/>

                            </group>
                        </group>
                    </div>

                    <!-- ================= FOOTER / SUMMARY ================= -->
                    <div style="margin-top:25px;padding-top:15px;border-top:1px solid #ddd;
                                display:flex;align-items:center;justify-content:space-between;">

<!--                        <div style="display:flex;align-items:center;gap:10px;">-->
<!--                            -->

<!--                        </div>-->

                        <div style="font-size:13px;color:#999;">
                            Last Updated:
                            <field name="write_date" readonly="1" nolabel="1"/>
                        </div>
                    </div>
                                            <!-- Pages -->
                    <notebook>
                        <page string="Plans">
                            <field name="plan_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>

                        <page string="Evaluations">
                            <field name="evaluation_ids">
                                <list editable="bottom">
                                    <field name="evaluation_date"/>
                                </list>
                            </field>
                        </page>

                        <page string="Activities">
                            <field name="custom_activity_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="status"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </list>
                            </field>
                        </page>

                        <page string="Attachments">
                            <field name="custom_attachment_ids" widget="many2many_binary"/>

                        </page>

                    </notebook>
                </sheet>

                <!-- Chatter -->
                <chatter/>

            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_custom_partner_kanban" model="ir.ui.view">
        <field name="name">custom.partner.kanban</field>
        <field name="model">custom.partner</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="partnership_duration"/>
                <field name="website_url"/>
                <field name="company_logo"/>
                <field name="end_date"/>
                <field name="plan_progress"/>
                <field name="priority"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="o_kanban_record">

                            <!-- Logo -->
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('custom.partner', 'company_logo', record.id.value)"
                                     alt="Logo" class="rounded-lg"
                                     style="max-height:30px; max-width:30px;" />
                            </div>

                            <!-- Partner Info -->
                            <div class="o_kanban_details">
                                <!-- Name -->
                                <strong>
                                    <field name="name"/>
                                </strong>

                                <!-- Partnership Duration -->
                                <div>
                                    <span>Duration: </span>
                                    <field name="partnership_duration"/>
                                </div>

                                <!-- End Date -->
                                <t t-if="record.end_date.value">
                                    <t t-if="new Date(record.end_date.value).getTime() &lt; new Date()">
                                        <div style="color:red;">
                                            <b>End:</b> <field name="end_date"/>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div><b>End:</b> <field name="end_date"/></div>
                                    </t>
                                </t>
                                <div>
                                    <span>Progress: </span>
                                    <field name="plan_progress"
                                           widget="progressbar" options="{'max_value': 100}"/>
                                </div>

                                <div>
                                <field name="priority" widget="priority"/>
                                </div>


                                <!-- Website -->
                                <t t-if="record.website_url.value">
                                    <a t-att-href="record.website_url.value" target="_blank"
                                       class="btn btn-primary btn-sm mt-2">
                                        Visit Website
                                    </a>
                                </t>
                                <t t-else="">
                                    <div style="color: gray; font-size: 12px; margin-top:6px;">
                                        No Website
                                    </div>
                                </t>

                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="custom_partner_view_search" model="ir.ui.view">
        <field name="name">custom.partner.view.search</field>
        <field name="model">custom.partner</field>
        <field name="arch" type="xml">
            <search string="Business Partners">
                <!-- SEARCH FIELDS -->
                <field name="name"/>
                <field name="partner_type"/>
                <field name="partnership_type_id"/>
                <field name="responsible_user_id"/>
                <field name="priority"/>
                <field name="country"/>
                <field name="plan_progress"/>
                <field name="activity_weighted_progress"/>

                <!-- STATE FILTERS -->
                <filter string="Approved" name="approved" domain="[('partner_approved','=',True)]"/>
                <filter string="Not Approved" name="not_approved" domain="[('partner_approved','=',False)]"/>
                <filter string="Local" name="local" domain="[('partner_type','=','local')]"/>
                <filter string="International" name="international" domain="[('partner_type','=','international')]"/>

                <!-- GROUP BY -->
                <group expand="0" string="Group By">
                    <filter string="Partner Type" name="group_partner_type" context="{'group_by':'partner_type'}"/>
                    <filter string="Partnership Type" name="group_partnership_type" context="{'group_by':'partnership_type_id'}"/>
                    <filter string="Responsible User" name="group_responsible_user" context="{'group_by':'responsible_user_id'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by':'priority'}"/>
                </group>
            </search>
        </field>
    </record>



    <!-- Action -->
    <record id="action_partner" model="ir.actions.act_window">
        <field name="name">Partners</field>
        <field name="res_model">custom.partner</field>
        <field name="view_mode">kanban,form</field>
    </record>

</odoo>
