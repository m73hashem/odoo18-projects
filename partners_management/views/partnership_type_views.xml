<odoo>

    <!-- قائمة الأنواع -->
        <record id="view_partnership_type_list" model="ir.ui.view">
            <field name="name">partnership.type.list</field>
            <field name="model">partnership.type</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- نموذج إدخال نوع الشراكة -->
        <record id="view_partnership_type_form" model="ir.ui.view">
            <field name="name">partnership.type.form</field>
            <field name="model">partnership.type</field>
            <field name="arch" type="xml">
                <form string="Partnership Type">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="description"/>
                            <field name="active"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- الإجراء (Action) -->
        <record id="action_partnership_type" model="ir.actions.act_window">
            <field name="name">Partnership Types</field>
            <field name="res_model">partnership.type</field>
            <field name="view_mode">list,form</field>
        </record>

</odoo>
