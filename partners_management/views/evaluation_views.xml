<odoo>
    <record id="view_partner_evaluation_list" model="ir.ui.view">
        <field name="name">partner.evaluation.list</field>
        <field name="model">partner.evaluation</field>
        <field name="groups_id" eval="[(4, ref('partners_management.group_partner_manager'))]"/>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="evaluation_date"/>
            </list>
        </field>
    </record>

    <record id="view_partner_evaluation_form" model="ir.ui.view">
        <field name="name">partner.evaluation.form</field>
        <field name="model">partner.evaluation</field>
        <field name="arch" type="xml">
            <form>
                
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_survey" class="oe_stat_button" icon="fa-check-square-o"
                                type="object" string="Survey">
                            <field name="survey_id" widget="statinfo" invisible="1"/>
                        </button>
                    </div>
                    <div class="oe_title mb24">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <field name="partner_id"/>
                        <field name="evaluation_date"/>
                    </group>

                </sheet>

                <!-- Chatter -->
                <chatter/>

            </form>
        </field>
    </record>

    <record id="partner_evaluation_view_search" model="ir.ui.view">
        <field name="name">partner.evaluation.view.search</field>
        <field name="model">partner.evaluation</field>
        <field name="arch" type="xml">
            <search string="Partner Evaluations">
                <!-- SEARCH FIELDS -->
                <field name="name"/>
                <field name="partner_id"/>
                <field name="evaluation_date"/>
                <field name="survey_id"/>

                <!-- STATE FILTERS -->
                <filter string="With Survey" name="with_survey" domain="[('survey_id','!=',False)]"/>
                <filter string="Without Survey" name="without_survey" domain="[('survey_id','=',False)]"/>

                <!-- GROUP BY -->
                <group expand="0" string="Group By">
                    <filter string="Partner" name="group_partner" context="{'group_by':'partner_id'}"/>
                    <filter string="Evaluation Date" name="group_evaluation_date" context="{'group_by':'evaluation_date'}"/>
                </group>
            </search>
        </field>
    </record>


    <!-- Action -->
    <record id="action_evaluation" model="ir.actions.act_window">
        <field name="name">Evaluations</field>
        <field name="res_model">partner.evaluation</field>
        <field name="view_mode">form,list</field>
        <field name="view_id" ref="view_partner_evaluation_list"/>
        <field name="context">{'group_by': 'partner_id'}</field>
    </record>

</odoo>
