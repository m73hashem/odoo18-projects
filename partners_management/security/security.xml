<odoo>
    <!-- access groups -->
    <record id="group_partner_manager" model="res.groups">
        <field name="name">Partner Manager</field>
        <field name="category_id" ref="partners_management.partners_management_category"/>
    </record>

    <record id="group_partner_user" model="res.groups">
        <field name="name">Partner User</field>
        <field name="category_id" ref="partners_management.partners_management_category"/>
    </record>

    <!--  مدير النظام -->
    <record id="group_partners_system_manager" model="res.groups">
        <field name="name">Partners System Manager</field>
        <field name="category_id" ref="partners_management.partners_management_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <!--  مدير الشراكات  -->
    <record id="group_partners_manager" model="res.groups">
        <field name="name">Partnerships Manager (Project Manager)</field>
        <field name="category_id" ref="partners_management.partners_management_category"/>
    </record>

    <!-- منسق الشراكات -->
    <record id="group_partners_coordinator" model="res.groups">
        <field name="name">Partnerships Coordinator</field>
        <field name="category_id" ref="partners_management.partners_management_category"/>
    </record>

    <!--  الفريق القانوني -->
    <record id="group_partners_legal" model="res.groups">
        <field name="name">Legal Team</field>
        <field name="category_id" ref="partners_management.partners_management_category"/>
    </record>

    <!-- مستخدم استشاري / مطلع -->
    <record id="group_partners_viewer" model="res.groups">
        <field name="name">Partners Viewer</field>
        <field name="category_id" ref="partners_management.partners_management_category"/>
    </record>


    <!-- portal user -->
    <record id="rule_portal_plan_all" model="ir.rule">
        <field name="name">Portal: All Plans</field>
        <field name="model_id" ref="model_custom_partner"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>


    <!-- access rules -->
    <record id="partner_activity_user_rule" model="ir.rule">
        <field name="name">Partner Activity: User sees only their activities</field>
        <field name="model_id" ref="model_partner_activity"/>
        <field name="domain_force">['|', ('responsible_user_id','=',user.id), ('create_uid','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('partners_management.group_partner_user'))]"/>
    </record>

</odoo>
